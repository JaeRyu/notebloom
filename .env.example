# OAuth client values from Google Cloud console > APIs & Services > Credentials. Save as .env.local (never committed).
# Easiest: run `npm run setup:google`, which walks you through it and writes .env.local for you.

# Web version: 'OAuth client ID > Web application'
VITE_GOOGLE_WEB_CLIENT_ID=

# Desktop & mobile apps (Tauri): 'OAuth client ID > TVs and Limited Input devices'
VITE_GOOGLE_DEVICE_CLIENT_ID=
VITE_GOOGLE_DEVICE_CLIENT_SECRET=
