# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 에서 만든 OAuth 클라이언트 값을 넣고 .env.local 로 저장하세요.
# 자세한 방법은 README 의 "Google Drive 연결 설정" 참고.

# 웹 브라우저용: 'OAuth 클라이언트 ID > 웹 애플리케이션'
VITE_GOOGLE_WEB_CLIENT_ID=

# 데스크톱/모바일 앱(Tauri)용: 'OAuth 클라이언트 ID > TV 및 입력 제한 기기'
VITE_GOOGLE_DEVICE_CLIENT_ID=
VITE_GOOGLE_DEVICE_CLIENT_SECRET=
