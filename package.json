{
  "name": "notebloom",
  "private": true,
  "version": "0.1.0",
  "description": "Google Drive 로 동기화되는 Notion 스타일 개인 노트 앱 (웹 · Windows · macOS · Android · iOS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock --host 127.0.0.1 --port 5174 --strictPort",
    "mock-drive": "node scripts/mock-drive.mjs",
    "setup:google": "node scripts/setup-google.mjs",
    "build": "npm run notices && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "spdx-license-list": "^6.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
